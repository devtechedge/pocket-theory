# POCKET THEORY - Environment Template (Placeholders Only)
# Copy to .env for local PostgreSQL setup. When DATABASE_URL is omitted locally,
# POCKET THEORY boots an embedded PGLite instance and seeds the 40 demo SKUs.

# Primary PostgreSQL connection (pooled recommended for Vercel serverless)
DATABASE_URL="postgresql://user:password@localhost:5432/pocket_theory"

# Direct unpooled PostgreSQL connection for DDL migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/pocket_theory"

# Dedicated integration & E2E test databases (must contain _test or _e2e)
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/pocket_theory_test"
DATABASE_URL_E2E="postgresql://user:password@localhost:5432/pocket_theory_e2e"

# Canonical site origin (update after Vercel alias assignment)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Long random server secret (>=32 chars) used to pepper session/cart token hashes
SESSION_PEPPER="replace-with-at-least-32-random-hex-characters"

# Demo environment flag ("1" enables non-charging demo payment sandbox and DEMO_ILLUSTRATIVE SKUs; "0" enforces live commercial gates)
DEMO_MODE="1"

# Explicit guard required to seed a database whose name does not contain test/e2e
ALLOW_PROD_SEED="0"

# Optional Live Payment Gateways (when omitted, checkout switches to clearly labelled Non-Charging Demo Payment Sandbox)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional Transactional Email Provider (when omitted, emails write to PostgreSQL email_outbox sink)
EMAIL_FROM="orders@pockettheory.example"
EMAIL_PROVIDER_API_KEY=""
